# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env (ver .gitignore).

# --- LLM (gerar_roteiro, autocritica_conteudo, pesquisar_tendencias_nicho) — OpenAI ---
OPENAI_API_KEY=
# tier intermediário — usado em gerar_roteiro
OPENAI_MODEL_ROTEIRO=
# tier mais barato/rápido, com visão — usado em autocritica_conteudo
# (precisa enxergar as peças renderizadas p/ julgar layout/foto/identidade)
OPENAI_MODEL_AUTOCRITICA=

# --- Imagem (estático/carrossel) — motor de template, SEM IA ---
# Não há modelo de imagem por IA aqui: o carrossel/estático é renderizado
# por HTML/CSS via Chromium headless (Playwright). Depois de
# `pip install -r requirements.txt`, rode uma vez: playwright install chromium
# Design tokens (cores/tipografia/cabeçalho) vêm de perfil-marca.md.

# --- Fotos de estoque (templates foto_split / capa com imagem) — Unsplash ---
# Gratuita, mas ainda é uma credencial. Crie um app em
# https://unsplash.com/oauth/applications e use o "Access Key".
UNSPLASH_ACCESS_KEY=

# --- Geração de vídeo (reel) — Gemini (Veo) ---
# Atenção: precisa vir de um projeto de API/Google AI Studio com billing
# próprio. A assinatura do app Gemini (Google AI Pro) NÃO libera esta cota.
GEMINI_API_KEY=
# tier padrão de reel (Veo 3.1 Fast) — default no código: veo-3.1-fast-generate-001
GEMINI_MODEL_VIDEO_PADRAO=
# tier premium (Veo 3.1 completo) — default no código: veo-3.1-generate-001
GEMINI_MODEL_VIDEO_PREMIUM=

# --- Publicação em rede social — bundle.social (API unificada multi-rede) ---
BUNDLE_SOCIAL_API_KEY=
BUNDLE_SOCIAL_ACCOUNT_ID_INSTAGRAM=
# opcional — default: https://api.bundle.social (confirmar contra a doc
# oficial ao integrar de verdade, ver adapters/redes_sociais/bundle_social_adapter.py)
BUNDLE_SOCIAL_API_BASE_URL=

# --- Persistência (opcional — default: dados/agente.db) ---
DATABASE_PATH=

# --- Casca HTTP interna (api/) — consumida só pelo backend do front-end ---
# Chave compartilhada verificada em TODO request (header X-API-Key). Gere uma
# aleatória forte (ex: `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# Sem ela, a casca HTTP não sobe. NÃO tem relação com o CLI.
AGENTE_API_KEY=
# Bind — NUNCA 0.0.0.0. Default já é 127.0.0.1:8790.
AGENTE_API_HOST=127.0.0.1
AGENTE_API_PORT=8790
# Caminho do perfil-marca.md real que o runtime consome via --perfil e que
# PUT /perfil reescreve. Default: config-exemplo/perfil-marca.md
PERFIL_PATH=
# Rate limit local da casca (2ª camada; a 1ª é no backend do front-end).
# Nº máximo de POST /execucoes por janela. Protege contra custo de LLM/Veo.
EXEC_MAX_POR_HORA=2
EXEC_MAX_POR_DIA=8
